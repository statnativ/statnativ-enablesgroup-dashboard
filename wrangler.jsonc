{
  // Deploys the built dist/ folder as static assets — no server-side Worker
  // code. This is a plain static React SPA (see README.md), so we bypass
  // Wrangler's Vite-project auto-configuration (which requires Vite >= 6)
  // by declaring the assets config ourselves.
  "name": "statnativ-enablesgroup-dashboard",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "dist",
    // React Router client-side routes (e.g. /dashboard/documents) must fall
    // back to index.html instead of 404ing on a direct load/refresh.
    "not_found_handling": "single-page-application"
  }
}
